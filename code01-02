#设置质控标准
#基因
minGene=200
#counts
minUMI=600
#线粒体
pctMT=10
#血细胞
pctHB=1

#数据质控并绘制小提琴图
pbmc <- subset(pbmc, subset = nFeature_RNA > minGene  &
                 nCount_RNA > minUMI & percent.mt < pctMT & percent.HB < pctHB)
plots = list()
for(i in seq_along(plot.featrures)){
  plots[[i]] = VlnPlot(pbmc, group.by=group, pt.size = 0,
                       features = plot.featrures[i]) + theme.set2 + NoLegend()}
violin <- wrap_plots(plots = plots, nrow=2)    
violin
ggsave("./figs-02/2vlnplot_after_qc.pdf", plot = violin, width = 14, height = 8) 
