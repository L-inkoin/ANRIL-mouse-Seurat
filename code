# 从Seurat对象获取metadata
meta <- pbmc@meta.data

# 1. 按cluster统计各年龄组细胞数
cluster_counts <- meta %>%
  group_by(seurat_clusters, orig.ident) %>%
  summarise(n = n()) %>%
  pivot_wider(names_from = orig.ident, values_from = n, values_fill = 0)

# 2. 计算每个cluster的Odds Ratio
calc_odds_ratio <- function(df) {
  total_adult <- sum(df$ApoE_, na.rm = TRUE)       # 对照组总数
  total_aged <- sum(df$ApoE_ANRIL, na.rm = TRUE)   # 实验组总数
  
  df %>%
    mutate(
      a = ApoE_ANRIL,         # 实验组在该cluster的细胞数
      b = ApoE_,              # 对照组在该cluster的细胞数
      c = total_aged - a,     # 实验组不在该cluster的细胞数
      d = total_adult - b,    # 对照组不在该cluster的细胞数
      OR = (a/c)/(b/d),
      log2OR = log2(OR)
    )
}

cluster_or <- calc_odds_ratio(cluster_counts)

